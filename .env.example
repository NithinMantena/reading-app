# Frontend (public, safe to commit as repo variables — the anon key is protected by RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Base path of the deployed site (GitHub Pages project URL). Leave "/" for local dev.
VITE_BASE_PATH=/reading-app/

# Backend (Edge Function secrets; set with `supabase secrets set`, NEVER commit real values)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected automatically by Supabase.
OWNER_GITHUB_LOGIN=NithinMantena
# Phase 2+: model and search providers
# ANTHROPIC_API_KEY=
# SEARCH_API_KEY=
